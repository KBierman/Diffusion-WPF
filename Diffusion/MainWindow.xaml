<Window x:Class="Diffusion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diffusion"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid x:Name="ScreenGrid" HorizontalAlignment="Center" Height="326" VerticalAlignment="Top" Width="326" Margin="0,10,0,0" Background="#FF9E5252"/>
        <Label x:Name="tickCounter" Content="Not Initialized" HorizontalAlignment="Center" Margin="0,375,0,0" VerticalAlignment="Top"/>
        <Label Content="Kill" HorizontalAlignment="Left" Margin="21,343,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="killBox" HorizontalAlignment="Left" Margin="52,347,0,0" TextWrapping="Wrap" Text="0.062" VerticalAlignment="Top" Width="120"/>
        <Label Content="Feed" HorizontalAlignment="Left" Margin="21,366,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="feedBox" HorizontalAlignment="Left" Margin="52,370,0,0" TextWrapping="Wrap" Text="0.055" VerticalAlignment="Top" Width="120"/>
        <Label Content="dA" HorizontalAlignment="Left" Margin="584,343,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="DABox" HorizontalAlignment="Left" Margin="614,347,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="120"/>
        <Label Content="dB" HorizontalAlignment="Left" Margin="584,366,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="DBBox" HorizontalAlignment="Left" Margin="614,370,0,0" TextWrapping="Wrap" Text="0.5" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="resetButton" Content="Reset" HorizontalAlignment="Left" Margin="608,18,0,0" VerticalAlignment="Top" Click="resetButton_Click"/>
        <Button x:Name="pauseButton" Content="Stop" HorizontalAlignment="Left" Margin="667,18,0,0" VerticalAlignment="Top" Click="pauseButton_Click"/>
        <TextBox x:Name="sandBox" HorizontalAlignment="Left" Margin="608,77,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="30"/>
        <Label Content="Sands of Time" HorizontalAlignment="Left" Margin="596,51,0,0" VerticalAlignment="Top"/>
        <Label Content="Tick" HorizontalAlignment="Left" Margin="638,73,0,0" VerticalAlignment="Top"/>
        <Button x:Name="sandButton" Content="Update" HorizontalAlignment="Left" Margin="689,77,0,0" VerticalAlignment="Top" Click="sandButton_Click"/>
        <Label x:Name="loadLabel" Content="" HorizontalAlignment="Left" Margin="614,108,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
